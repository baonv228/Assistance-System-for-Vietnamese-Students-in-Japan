# =============================================================================================
# LOCAL CONFIGURATION
# File: application-local.properties
# This file is git-ignored. Never commit real passwords or secrets.
# =============================================================================================

# ---------------------------------------------------------------------------------------------
# MySQL Database Configuration
# ---------------------------------------------------------------------------------------------
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_ROOT_PASSWORD

# ---------------------------------------------------------------------------------------------
# Flyway Migration Configuration
# Enable baseline for an existing database that already contains tables.
# IMPORTANT: Only enable after confirming existing schema matches the baseline migration.
# ---------------------------------------------------------------------------------------------
spring.flyway.baseline-on-migrate=true

# ---------------------------------------------------------------------------------------------
# JPA / Hibernate Configuration (optional)
# ---------------------------------------------------------------------------------------------
# Print SQL while developing
# spring.jpa.show-sql=true

# ---------------------------------------------------------------------------------------------
# Email Configuration (optional)
# Without these lines, the sign-up code is printed in the console instead of
# being emailed, which is enough for local development.
#
# Gmail:
# 1. Turn on 2-Step Verification.
# 2. Create an App Password (16 characters).
# ---------------------------------------------------------------------------------------------
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your.address@gmail.com
# spring.mail.password=YOUR_16_CHAR_APP_PASSWORD
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# app.mail.from=Senpai oi <your.address@gmail.com>

# ---------------------------------------------------------------------------------------------
# Google Login Configuration (optional)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# Application type: Web application
#
# Authorized redirect URIs (one line each, exactly):
# http://localhost:8080/login/oauth2/code/google
# https://senpaioi.com/login/oauth2/code/google      (the server; = APP_PUBLIC_URL + /login/oauth2/code/google)
# For people outside the test user list: OAuth consent screen → Audience → "Publish app" (In production).
# ---------------------------------------------------------------------------------------------
# spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
# spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
# spring.security.oauth2.client.registration.google.scope=openid,profile,email

# ---------------------------------------------------------------------------------------------
# Facebook Login Configuration (optional)
# developers.facebook.com -> Create App -> Facebook Login
#
# Valid OAuth Redirect URIs:
# http://localhost:8080/login/oauth2/code/facebook
# https://senpaioi.com/login/oauth2/code/facebook    (the server)
# For people without a role on the app: App settings → Basic (privacy policy https://senpaioi.com/terms?doc=privacy,
# data deletion instructions https://senpaioi.com/data-deletion, icon, category), then App mode "Live".
# On the server the same keys go in environment variables, e.g. SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID.
# ---------------------------------------------------------------------------------------------
# spring.security.oauth2.client.registration.facebook.client-id=YOUR_FACEBOOK_APP_ID
# spring.security.oauth2.client.registration.facebook.client-secret=YOUR_FACEBOOK_APP_SECRET
# spring.security.oauth2.client.registration.facebook.scope=email,public_profile
# ---------------------------------------------------------------------------------------------
# Photo scan for posts (optional)
# OpenAI Moderation is free. Create a key at https://platform.openai.com/api-keys and paste it here
# (or set the OPENAI_API_KEY environment variable). Without a key, photos are not really checked:
# app.moderation.dev-result decides the result (PASS, or FLAG to see the "rejected" flow).
# ---------------------------------------------------------------------------------------------
# app.moderation.openai.api-key=sk-...
# app.moderation.dev-result=FLAG

# ---------------------------------------------------------------------------------------------
# Reading text in photos and videos (optional)
# Gemini Flash-Lite has a free tier (no card needed). Create a key at https://aistudio.google.com/apikey
# and paste it here (or set the GEMINI_API_KEY environment variable). Gemini reads the text in each photo
# and video and the words spoken in a video; that text then goes through the banned keywords and the link
# rule. Without a key, photos are only checked by the photo scan above and videos are not checked;
# app.moderation.dev-media-text then makes every photo and video "contain" that text (to see the rejection).
# ---------------------------------------------------------------------------------------------
# app.moderation.gemini.api-key=YOUR_GEMINI_API_KEY
# app.moderation.dev-media-text=fb88

# ---------------------------------------------------------------------------------------------
# Uploaded media (optional). Files are saved in this folder and served at /media/**.
# ---------------------------------------------------------------------------------------------
# app.media.local-dir=uploads
#
# Or keep them in Cloudflare R2 (free tier: 10 GB, no egress fee). In the Cloudflare dashboard:
#   R2 Object Storage → Create bucket (e.g. asvsj-media-dev; leave "Public access" off)
#   R2 Object Storage → Manage API tokens → Create Account API token, permission "Object Read & Write",
#   "Apply to specific buckets only" = that bucket → copy the Access Key ID and Secret Access Key here.
# The account id is shown on the R2 overview page. Use one bucket per environment (dev / server): the
# clean-up jobs delete files that their own database no longer needs.
# import-from copies an older local folder into the bucket once at the start (remove it afterwards).
# app.media.storage=r2
# app.media.r2.account-id=YOUR_ACCOUNT_ID
# app.media.r2.bucket=asvsj-media-dev
# app.media.r2.access-key-id=YOUR_ACCESS_KEY_ID
# app.media.r2.secret-access-key=YOUR_SECRET_ACCESS_KEY
# app.media.r2.import-from=uploads

# ---------------------------------------------------------------------------------------------
# Places for "Địa điểm liên quan" (optional)
# The search uses OpenStreetMap (free, no key, works from Vietnam): nothing to set up.
# Without internet, set dev-fake=true to try the flow with a few made-up places;
# enabled=false shows only the places already in ASVSJ.
# ---------------------------------------------------------------------------------------------
# app.places.dev-fake=true
# app.places.osm.enabled=false
# Countries searched (default Japan and Vietnam; empty = whole world)
# app.places.regions=jp,vn
#
# Also write the server log to a file (git-ignored by *.log), handy when the console is gone
# logging.file.name=logs/asvsj.log

# Testing the Map from outside Japan: "Vị trí của tôi" always gives this position (lat,lng,label) for every account.
# Development only: never set it on the server.
# app.map.dev-location=35.7281,139.7707,Ga Nippori
