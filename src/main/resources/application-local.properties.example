# =============================================================================================
# LOCAL CONFIGURATION
# File: application-local.properties
# This file is git-ignored. Never commit real passwords or secrets.
# =============================================================================================

# ---------------------------------------------------------------------------------------------
# MySQL Database Configuration
# ---------------------------------------------------------------------------------------------
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_ROOT_PASSWORD

# ---------------------------------------------------------------------------------------------
# Flyway Migration Configuration
# Enable baseline for an existing database that already contains tables.
# IMPORTANT: Only enable after confirming existing schema matches the baseline migration.
# ---------------------------------------------------------------------------------------------
spring.flyway.baseline-on-migrate=true

# ---------------------------------------------------------------------------------------------
# JPA / Hibernate Configuration (optional)
# ---------------------------------------------------------------------------------------------
# Print SQL while developing
# spring.jpa.show-sql=true

# ---------------------------------------------------------------------------------------------
# Email Configuration (optional)
# Without these lines, the sign-up code is printed in the console instead of
# being emailed, which is enough for local development.
#
# Gmail:
# 1. Turn on 2-Step Verification.
# 2. Create an App Password (16 characters).
# ---------------------------------------------------------------------------------------------
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your.address@gmail.com
# spring.mail.password=YOUR_16_CHAR_APP_PASSWORD
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# app.mail.from=Senpai oi <your.address@gmail.com>

# ---------------------------------------------------------------------------------------------
# Google Login Configuration (optional)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# Application type: Web application
#
# Authorized redirect URI:
# http://localhost:8080/login/oauth2/code/google
# ---------------------------------------------------------------------------------------------
# spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
# spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
# spring.security.oauth2.client.registration.google.scope=openid,profile,email

# ---------------------------------------------------------------------------------------------
# Facebook Login Configuration (optional)
# developers.facebook.com -> Create App -> Facebook Login
#
# Valid OAuth Redirect URI:
# http://localhost:8080/login/oauth2/code/facebook
# ---------------------------------------------------------------------------------------------
# spring.security.oauth2.client.registration.facebook.client-id=YOUR_FACEBOOK_APP_ID
# spring.security.oauth2.client.registration.facebook.client-secret=YOUR_FACEBOOK_APP_SECRET
# spring.security.oauth2.client.registration.facebook.scope=email,public_profile
# ---------------------------------------------------------------------------------------------
# Photo scan for posts (optional)
# OpenAI Moderation is free. Create a key at https://platform.openai.com/api-keys and paste it here
# (or set the OPENAI_API_KEY environment variable). Without a key, photos are not really checked:
# app.moderation.dev-result decides the result (PASS, or FLAG to see the "rejected" flow).
# ---------------------------------------------------------------------------------------------
# app.moderation.openai.api-key=sk-...
# app.moderation.dev-result=FLAG

# ---------------------------------------------------------------------------------------------
# Uploaded media (optional). Files are saved in this folder and served at /media/**.
# ---------------------------------------------------------------------------------------------
# app.media.local-dir=uploads

# ---------------------------------------------------------------------------------------------
# Places for "Địa điểm liên quan" (optional)
# The search uses OpenStreetMap (free, no key, works from Vietnam): nothing to set up.
# Without internet, set dev-fake=true to try the flow with a few made-up places;
# enabled=false shows only the places already in ASVSJ.
# ---------------------------------------------------------------------------------------------
# app.places.dev-fake=true
# app.places.osm.enabled=false
# Countries searched (default Japan and Vietnam; empty = whole world)
# app.places.regions=jp,vn
#
# Also write the server log to a file (git-ignored by *.log), handy when the console is gone
# logging.file.name=logs/asvsj.log
